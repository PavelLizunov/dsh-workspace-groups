{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DSH release inventory snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "captured_at", "source_profile", "dsh_version", "pnpm_version", "profile_package_json_sha256", "pnpm_lock_sha256", "pnpm_workspace_sha256", "profile_patch_sha256", "tree_hash_algorithm", "bundle_order", "rows", "scope"],
  "properties": {
    "schema_version": {"const": 2},
    "captured_at": {"type": "string", "format": "date-time"},
    "source_profile": {"const": "web-015"},
    "dsh_version": {"type": "string"},
    "pnpm_version": {"type": "string"},
    "profile_package_json_sha256": {"$ref": "#/$defs/hash"},
    "pnpm_lock_sha256": {"$ref": "#/$defs/hash"},
    "pnpm_workspace_sha256": {"$ref": "#/$defs/hash"},
    "profile_patch_sha256": {"$ref": "#/$defs/hash"},
    "tree_hash_algorithm": {"type": "string"},
    "scope": {"type": "string"},
    "bundle_order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "rows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/row"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_name", "bundle_id", "classification", "desired_state", "source_repo", "visibility", "license", "installed_version", "live_tree_sha256", "source_commit", "source_dirty", "stable_eligible", "release_strategy", "evidence", "dependency_spec", "direct_dependency", "declares_dsh_bundle"],
      "properties": {
        "package_name": {"type": "string", "minLength": 1},
        "bundle_id": {"type": ["string", "null"]},
        "classification": {"enum": ["core", "operator", "operator-fork", "third-party", "binary-only"]},
        "desired_state": {"enum": ["enabled", "retired", "quarantined", "dependency-only"]},
        "source_repo": {"type": ["string", "null"]},
        "visibility": {"enum": ["public", "private", "unknown"]},
        "license": {"type": "string"},
        "installed_version": {"type": "string"},
        "live_tree_sha256": {"$ref": "#/$defs/hash"},
        "source_commit": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/commit"}]},
        "source_dirty": {"type": ["boolean", "null"]},
        "stable_eligible": {"type": "boolean"},
        "release_strategy": {"type": "string"},
        "evidence": {"type": "string"},
        "dependency_spec": {"type": ["string", "null"]},
        "direct_dependency": {"type": "boolean"},
        "declares_dsh_bundle": {"type": "boolean"}
      }
    }
  }
}
